# Pinned versions for the GB300 debug ISO.
#
# Host software of NVIDIA's DGX GB300 NVL72 release 1.0.6
# (release notes RN-11874-001_1.0.6, sections 4.2 "Host Software Components" and
# 5.7 "MFT/Tools Firmware Package Contents"). Change these to follow a newer baseline.

# DGX OS 7.4.0 (the 1.0.6 host OS) is Ubuntu 24.04 with this kernel.
UBUNTU_SUITE=noble
UBUNTU_MIRROR=http://ports.ubuntu.com/ubuntu-ports
KERNEL_VERSION=6.17.0-1008-nvidia-64k

# GPU driver and IMEX 580.126.20 (open kernel modules, built with DKMS for KERNEL_VERSION)
NVIDIA_BRANCH=580
NVIDIA_VERSION=580.126.20

# DOCA-Host 3.2.1-044413 (MFT 4.34.1-12, DOCA-OFED kernel modules 25.10-1.7.1.409.1)
DOCA_VERSION=3.2.1-044413

# Tools from section 5.7
DCGM_VERSION=1:4.5.0-1
NVFWUPD_VERSION=2.0.8-1
# nvdebug 2.0.0 = open-nvdebug "initial_release_2.0.0" (Apache-2.0)
NVDEBUG_REPO=https://github.com/NVIDIA/open-nvdebug.git
NVDEBUG_COMMIT=37115c10162be9a1a0b5e39a7342130549adb1f9

# Package repositories and the fingerprints of the keys allowed to sign them
CUDA_REPO=https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/sbsa
CUDA_KEYRING_DEB=cuda-keyring_1.1-1_all.deb
CUDA_KEY_FPR=EB693B3035CD5710E231E123A4B469963BF863CC
DOCA_REPO=https://linux.mellanox.com/public/repo/doca/${DOCA_VERSION}/ubuntu24.04/arm64-sbsa
DOCA_KEY_URL=https://linux.mellanox.com/public/repo/doca/${DOCA_VERSION}/nvidia-doca-debian-gpg-public-key.asc
DOCA_KEY_FPR=70454E6BF5D9C2D3B78709E8DC726C5E41B9CC50
