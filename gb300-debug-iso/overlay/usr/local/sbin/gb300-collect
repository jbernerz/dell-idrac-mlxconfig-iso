#!/bin/bash
# gb300-collect - write a debug bundle for this node: GPU, NIC/DPU, PCIe, network, hardware
# errors, kernel and system logs, installed versions.
#
# Usage: gb300-collect [-o DIR] [--quick]
#   -o DIR    directory for the .tar.gz (default /root; the live system keeps it in RAM)
#   --quick   skip the slow parts (nvidia-bug-report.sh, mlxconfig queries)
set -u
OUTDIR=/root
QUICK=0
while [ $# -gt 0 ]; do
    case "$1" in
        -o) OUTDIR=$2; shift 2 ;;
        --quick) QUICK=1; shift ;;
        -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
mkdir -p "$OUTDIR"

serial=$(tr -c 'A-Za-z0-9._-\n' _ < /sys/class/dmi/id/product_serial 2>/dev/null | head -1)
name="gb300-debug-$(hostname)-${serial:-noserial}-$(date -u +%Y%m%dT%H%M%SZ)"
base=$(mktemp -d)
D=$base/$name
mkdir -p "$D"/{system,gpu,nic,net,storage,logs,hw}

# run FILE CMD...      - command output (and exit code) to FILE, with a timeout (T, default 120 s)
# sh_run FILE 'PIPELINE'
run()    { local f=$D/$1; shift; { echo "\$ $*"; timeout "${T:-120}" "$@"; echo "[exit $?]"; } >> "$f" 2>&1; printf '.'; }
sh_run() { local f=$D/$1; shift; { echo "\$ $1"; timeout "${T:-120}" sh -c "$1"; echo "[exit $?]"; } >> "$f" 2>&1; printf '.'; }
have()   { command -v "$1" >/dev/null 2>&1; }

echo "Collecting into $D"
# --- system
run system/release.txt cat /etc/gb300-debug-release
run system/uname.txt uname -a
run system/cmdline.txt cat /proc/cmdline
run system/uptime.txt uptime
run system/dmidecode.txt dmidecode
run system/lscpu.txt lscpu
run system/memory.txt free -h
run system/meminfo.txt cat /proc/meminfo
run system/numa.txt numactl -H
sh_run system/packages.txt "dpkg-query -W -f='\${Package} \${Version}\n' | grep -E 'nvidia|libnvidia|doca|mft|mlnx|rdma|ibverbs|dcgm|datacenter-gpu|imex|nvfwupd|linux-(image|modules)'"
run system/lsmod.txt lsmod
run system/dkms.txt dkms status

# --- PCIe
run hw/lspci-tree.txt lspci -tv
run hw/lspci-nn.txt lspci -nn
run hw/lspci-vvv.txt lspci -vvv -nn

# --- GPU
if have nvidia-smi; then
    run gpu/nvidia-smi.txt nvidia-smi
    run gpu/nvidia-smi-q.txt nvidia-smi -q
    run gpu/topo.txt nvidia-smi topo -m
    run gpu/nvlink-status.txt nvidia-smi nvlink -s
    run gpu/nvlink-errors.txt nvidia-smi nvlink -e
    run gpu/fabric.txt nvidia-smi -q -d FABRIC
    run gpu/ecc.txt nvidia-smi -q -d ECC,ROW_REMAPPER,PAGE_RETIREMENT
fi
run gpu/modinfo-nvidia.txt modinfo nvidia
sh_run gpu/xid.txt "journalctl -k -b --no-pager | grep -i -E 'NVRM|Xid|nvidia'"
if [ "$QUICK" -eq 0 ] && have nvidia-bug-report.sh; then
    echo; echo "nvidia-bug-report.sh (can take several minutes)"
    T=1200 run gpu/nvidia-bug-report.run.txt nvidia-bug-report.sh --output-file "$D/gpu/nvidia-bug-report.log"
fi
if have dcgmi; then
    sh_run gpu/dcgm.txt "pgrep -x nv-hostengine >/dev/null || nv-hostengine; sleep 3; dcgmi discovery -l; dcgmi discovery -c"
fi

# --- NIC / DPU (ConnectX-8, BlueField-3)
if have mst; then
    run nic/mst-start.txt mst start
    run nic/mst-status.txt mst status -v
fi
have ibdev2netdev && run nic/ibdev2netdev.txt ibdev2netdev -v
have ibstat && run nic/ibstat.txt ibstat
have ibv_devinfo && run nic/ibv_devinfo.txt ibv_devinfo -v
run nic/rdma-link.txt rdma link show
have mlxfwmanager && run nic/mlxfwmanager.txt mlxfwmanager --query
for dev in /sys/class/infiniband/*; do
    [ -e "$dev" ] || continue
    d=${dev##*/}
    have flint && run "nic/$d-flint.txt" flint -d "$d" q
    if have mlxlink; then
        run "nic/$d-mlxlink.txt" mlxlink -d "$d"
        run "nic/$d-mlxlink-module.txt" mlxlink -d "$d" -m
        run "nic/$d-mlxlink-counters.txt" mlxlink -d "$d" -c
    fi
    [ "$QUICK" -eq 0 ] && have mlxconfig && run "nic/$d-mlxconfig.txt" mlxconfig -d "$d" -e q
done
run nic/rshim.txt ls -l /dev/rshim0 /dev/rshim1

# --- network
run net/ip-addr.txt ip -d addr
run net/ip-link-stats.txt ip -s -s link
run net/ip-route.txt ip route show table all
run net/networkctl.txt networkctl status --all --no-pager
run net/resolvectl.txt resolvectl status
for i in /sys/class/net/*; do
    n=${i##*/}; [ "$n" = lo ] && continue
    run "net/ethtool-$n.txt" ethtool "$n"
    run "net/ethtool-$n.txt" ethtool -i "$n"
    run "net/ethtool-$n.txt" ethtool -S "$n"
    run "net/ethtool-$n.txt" ethtool -m "$n"
done
have lldpcli && run net/lldp-neighbors.txt lldpcli show neighbors details
run net/networkctl-lldp.txt networkctl lldp --no-pager

# --- storage
run storage/lsblk.txt lsblk -O
have nvme && run storage/nvme-list.txt nvme list
have smartctl && run storage/smartctl-scan.txt smartctl --scan

# --- hardware errors, BMC (in-band IPMI), sensors
have ras-mc-ctl && run hw/ras-summary.txt ras-mc-ctl --summary
have ras-mc-ctl && run hw/ras-errors.txt ras-mc-ctl --errors
have edac-util && run hw/edac.txt edac-util -v
if [ -e /dev/ipmi0 ] && have ipmitool; then
    run hw/ipmi-fru.txt ipmitool fru
    run hw/ipmi-sel.txt ipmitool sel elist
    run hw/ipmi-sdr.txt ipmitool sdr elist
    run hw/ipmi-lan.txt ipmitool lan print 1
fi
have sensors && run hw/sensors.txt sensors

# --- logs
run logs/dmesg.txt dmesg -T
run logs/journal-boot.txt journalctl -b --no-pager
run logs/journal-warnings.txt journalctl -b -p warning --no-pager
run logs/systemctl-failed.txt systemctl --failed --no-pager

tar -C "$base" -czf "$OUTDIR/$name.tar.gz" "$name" && rm -rf "$base"
echo
echo "Wrote $OUTDIR/$name.tar.gz ($(du -h "$OUTDIR/$name.tar.gz" | cut -f1))"
echo "This is a live system: copy it off before rebooting, for example"
echo "  scp root@<this node>:$OUTDIR/$name.tar.gz .        (needs SSH access, see debug-ssh-password)"
echo "  or to a USB stick / iDRAC removable disk:  lsblk; mount /dev/sdX1 /mnt; cp $OUTDIR/$name.tar.gz /mnt; umount /mnt"
