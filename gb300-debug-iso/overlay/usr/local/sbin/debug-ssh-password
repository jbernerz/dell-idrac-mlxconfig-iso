#!/bin/sh
# debug-ssh-password - allow SSH root login with a password, for this boot only.
# Sets a random root password, prints it, and enables password login. Nothing is written to
# the ISO: a reboot returns to key-only SSH.
set -e
[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
pw=$(tr -dc 'A-HJ-NP-Za-km-z2-9' < /dev/urandom | head -c 16)
echo "root:$pw" | chpasswd
# Files in sshd_config.d are read in order and the first value wins, so 40- beats 50-.
cat > /etc/ssh/sshd_config.d/40-debug-password.conf <<EOF
PermitRootLogin yes
PasswordAuthentication yes
EOF
systemctl restart ssh.service 2>/dev/null || systemctl restart ssh.socket
echo "SSH password login enabled until reboot."
echo "  user: root"
echo "  password: $pw"
echo "Addresses:"
ip -br -4 addr show scope global | sed 's/^/  /'
